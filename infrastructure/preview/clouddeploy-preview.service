[Unit]
Description=CloudDeploy app previews on the VM loopback interface
After=k3s.service
Requires=k3s.service

[Service]
ExecStart=/usr/local/bin/k3s kubectl -n clouddeploy-system port-forward --address=127.0.0.1 svc/clouddeploy-preview 3102:8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
