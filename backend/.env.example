DATABASE_URL=postgresql://clouddeploy:clouddeploy@localhost:5432/clouddeploy
JWT_SECRET=local-demo-only-change-this-key-before-hosting
PORT=4000
COOKIE_SECURE=false
KUBE_MODE=off
KUBE_NAMESPACE=clouddeploy-workloads
# Local listening port of the workload preview tunnel. Leave empty when no gateway is installed.
PREVIEW_PORT=
# Optional public mode. Use the DNS suffix served by the HTTPS workload gateway.
PUBLIC_APP_DOMAIN=
KUBE_API_URL=
KUBE_TOKEN_FILE=
KUBE_CA_FILE=
ALLOWED_IMAGES=docker.io/nginxinc/nginx-unprivileged:stable-alpine

GITHUB_BUILD_REPOSITORY=
GITHUB_BUILD_TOKEN=
GITHUB_BUILD_REF=main
